@{ Layout = null; }
<!DOCTYPE html>
<html lang="no">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Sparekopi tilbyr skreddersydde nettsider for bedrifter i Oslo. Mobilvenlig design, admin-panel og hosting inkludert." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title>Nettside & Webutvikling – Sparekopi Oslo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/variables.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/nav-footer.css" />
  <link rel="stylesheet" href="/css/components.css?v=4" />
  <link rel="stylesheet" href="/css/forms.css" />
  <style>
    /* ── WEBUTVIKLING HERO ── */
    .wh-section { padding: var(--space-2xl) var(--side-padding); }

    .wh-hero {
      background: var(--color-navy);
      padding: calc(var(--nav-height) + 6rem) var(--side-padding) 6rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
    }
    .wh-hero-tag {
      font-size: var(--fs-xs);
      font-weight: 500;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--color-gold2);
      margin-bottom: 1.5rem;
    }
    .wh-hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 5vw, 4.5rem);
      font-weight: 300;
      color: #fff;
      line-height: 1.1;
      margin-bottom: 1.5rem;
    }
    .wh-hero-title em { font-style: italic; color: var(--color-gold3); }
    .wh-hero-sub {
      font-size: var(--fs-sm);
      color: rgba(255,255,255,.6);
      line-height: 1.85;
      margin-bottom: 2.5rem;
      max-width: 480px;
    }
    .wh-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .wh-hero-img {
      width: 100%;
      border-radius: 8px;
      box-shadow: 0 32px 80px rgba(0,0,0,.5);
      display: block;
    }

    /* ── FEATURES ── */
    .wh-features { background: var(--color-cream2); }
    .wh-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 1px solid var(--color-cream3);
      margin-top: 3rem;
    }
    .wh-feature {
      padding: 2.5rem 2rem;
      border-right: 1px solid var(--color-cream3);
      border-bottom: 1px solid var(--color-cream3);
    }
    .wh-feature:nth-child(3n) { border-right: none; }
    .wh-feature:nth-last-child(-n+3) { border-bottom: none; }
    .wh-feature-num {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 300;
      color: var(--color-gold);
      opacity: .5;
      margin-bottom: 1rem;
    }
    .wh-feature h3 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 400;
      color: var(--color-navy);
      margin-bottom: .6rem;
    }
    .wh-feature p { font-size: var(--fs-sm); color: var(--color-muted); line-height: 1.7; }

    /* ── PROSESS ── */
    .wh-process { background: var(--color-cream); }
    .wh-steps { margin-top: 3rem; display: flex; flex-direction: column; }
    .wh-step {
      display: grid;
      grid-template-columns: 80px 1fr;
      gap: 2rem;
      padding: 2.5rem 0;
      border-top: 1px solid var(--color-cream3);
      align-items: start;
    }
    .wh-step:last-child { border-bottom: 1px solid var(--color-cream3); }
    .wh-step-num {
      font-family: var(--font-display);
      font-size: 3rem;
      font-weight: 300;
      color: var(--color-gold);
      opacity: .3;
      line-height: 1;
      text-align: center;
    }
    .wh-step h3 {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 400;
      color: var(--color-navy);
      margin-bottom: .5rem;
    }
    .wh-step p { font-size: var(--fs-sm); color: var(--color-muted); line-height: 1.75; }

    /* ── REFERANSE ── */
    .wh-ref-section { background: var(--color-navy); }
    .wh-ref {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
      margin-top: 3rem;
    }
    .wh-ref-img { width: 100%; border-radius: 6px; box-shadow: 0 20px 60px rgba(0,0,0,.5); display: block; }
    .wh-ref-tag { font-size: var(--fs-xs); font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--color-gold2); margin-bottom: 1rem; }
    .wh-ref-title { font-family: var(--font-display); font-size: 1.8rem; font-weight: 300; color: #fff; margin-bottom: 1rem; }
    .wh-ref-desc { font-size: var(--fs-sm); color: rgba(255,255,255,.55); line-height: 1.85; margin-bottom: 1.75rem; }
    .wh-ref-list { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: .6rem; }
    .wh-ref-list li { font-size: var(--fs-sm); color: rgba(255,255,255,.55); }
    .wh-ref-list li::before { content: '✦ '; color: var(--color-gold2); font-size: .6rem; }

    /* ── TILBUD ── */
    .wh-offer-section { background: var(--color-cream2); }
    .wh-offer-lead {
      font-size: clamp(1.15rem, 2vw, 1.35rem);
      font-family: var(--font-display);
      font-weight: 300;
      color: var(--color-navy);
      line-height: 1.7;
      max-width: 680px;
      margin: 1.75rem 0 3rem;
    }
    .wh-offer-lead em { font-style: italic; color: var(--color-gold3); }
    .wh-offer-factors {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      border: 1px solid var(--color-cream3);
      margin-bottom: 3rem;
    }
    .wh-offer-factor {
      padding: 2.25rem 2rem;
      border-right: 1px solid var(--color-cream3);
    }
    .wh-offer-factor:last-child { border-right: none; }
    .wh-offer-factor-num {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 300;
      color: var(--color-gold);
      opacity: .45;
      margin-bottom: .85rem;
    }
    .wh-offer-factor h3 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      font-weight: 400;
      color: var(--color-navy);
      margin-bottom: .4rem;
    }
    .wh-offer-factor p { font-size: var(--fs-sm); color: var(--color-muted); line-height: 1.7; }

    /* ── KONTAKT ── */
    .wh-contact-section { background: var(--color-navy); }
    .wh-contact-section .wh-sec-title { color: #fff; }
    .wh-contact {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 6rem;
      align-items: start;
      margin-top: 3rem;
    }
    .wh-contact-intro { font-size: var(--fs-sm); color: rgba(255,255,255,.55); line-height: 1.85; margin-bottom: 2rem; }
    .wh-contact-item { padding: 1.2rem 0; border-bottom: 1px solid rgba(255,255,255,.1); }
    .wh-contact-item:first-of-type { border-top: 1px solid rgba(255,255,255,.1); }
    .wh-contact-label { font-size: var(--fs-xs); font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--color-gold2); margin-bottom: .3rem; }
    .wh-contact-val { font-family: var(--font-display); font-size: 1.1rem; color: #fff; font-weight: 300; }
    .wh-contact-val a { color: #fff; transition: color .2s; }
    .wh-contact-val a:hover { color: var(--color-gold); }
    .wh-contact-section .form-label { color: rgba(255,255,255,.6); }
    .wh-contact-section .form-control {
      background: rgba(255,255,255,.06);
      border-color: rgba(255,255,255,.15);
      color: #fff;
    }
    .wh-contact-section .form-control::placeholder { color: rgba(255,255,255,.3); }
    .wh-contact-section .form-control:focus {
      border-color: var(--color-gold);
      background: rgba(255,255,255,.09);
      outline: none;
    }

    /* ── SEC HEADER ── */
    .wh-sec-tag { font-size: var(--fs-xs); font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--color-gold); margin-bottom: .75rem; }
    .wh-sec-title { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 300; color: var(--color-navy); line-height: 1.15; }
    .wh-sec-title em { font-style: italic; color: var(--color-gold3); }
    .wh-ref-section .wh-sec-title,
    .wh-contact-section .wh-sec-title { color: #fff; }
    .wh-contact-section .wh-sec-tag { color: var(--color-gold2); }

    /* ── UTVIKLER ── */
    .wh-dev-section { background: var(--color-cream); }
    .wh-dev {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      align-items: start;
      margin-top: 3rem;
    }
    .wh-dev-text { font-size: var(--fs-sm); color: var(--color-muted); line-height: 1.85; margin-bottom: 1.5rem; }
    .wh-dev-name {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 300;
      color: var(--color-navy);
      margin-bottom: .3rem;
    }
    .wh-dev-role { font-size: var(--fs-xs); font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--color-gold); margin-bottom: 1.5rem; }
    .wh-dev-projects { display: flex; flex-direction: column; gap: 1rem; }
    .wh-dev-project {
      padding: 1.4rem 1.75rem;
      border: 1px solid var(--color-cream3);
      background: var(--color-cream2);
    }
    .wh-dev-project-tag { font-size: .65rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--color-gold); margin-bottom: .4rem; }
    .wh-dev-project h4 { font-family: var(--font-display); font-size: 1.1rem; font-weight: 400; color: var(--color-navy); margin-bottom: .3rem; }
    .wh-dev-project p { font-size: var(--fs-xs); color: var(--color-muted); line-height: 1.7; margin: 0; }

    /* ── RESPONSIVE ── */
    @@media (max-width: 900px) {
      .wh-section { padding: var(--space-xl) var(--side-padding); }
      .wh-hero { grid-template-columns: 1fr; padding-top: calc(var(--nav-height) + 3rem); padding-bottom: 3.5rem; gap: 2rem; }
      .wh-hero-img { display: none; }
      .wh-hero-actions { flex-direction: column; }
      .wh-hero-actions a { text-align: center; }
      .wh-grid { grid-template-columns: 1fr; }
      .wh-feature { border-right: none; }
      .wh-feature:nth-last-child(-n+3) { border-bottom: 1px solid var(--color-cream3); }
      .wh-feature:last-child { border-bottom: none; }
      .wh-step { grid-template-columns: 56px 1fr; gap: 1.2rem; }
      .wh-step-num { font-size: 2.2rem; }
      .wh-ref { grid-template-columns: 1fr; }
      .wh-ref-img { display: none; }
      .wh-offer-factors { grid-template-columns: 1fr; }
      .wh-offer-factor { border-right: none; border-bottom: 1px solid var(--color-cream3); }
      .wh-offer-factor:last-child { border-bottom: none; }
      .wh-contact { grid-template-columns: 1fr; gap: 3rem; }
      .wh-dev { grid-template-columns: 1fr; gap: 2.5rem; }
    }
    @@media (max-width: 480px) {
      .wh-hero { padding-left: 1.25rem; padding-right: 1.25rem; }
      .wh-section { padding-left: 1.25rem; padding-right: 1.25rem; }
      .wh-hero-title { font-size: 2.2rem; }
      .wh-sec-title { font-size: 1.8rem; }
      .wh-step { grid-template-columns: 44px 1fr; }
      .wh-step-num { font-size: 1.8rem; }
    }
  </style>
</head>
<body>

  <nav class="site-nav">
    <a href="/" class="nav-logo"><img src="/assets/images/logo-sparekopi.png" alt="Sparekopi" class="nav-logo-img" height="48" /></a>
    <button class="nav-toggle" id="navToggle"><span></span><span></span><span></span></button>
    <ul class="nav-links">
      <li><a href="/Home/Tjenester">Tjenester</a></li>
      <li><a href="/Home/Webutvikling" class="active">Webutvikling</a></li>
      <li><a href="/Home/Priser">Priser</a></li>
      <li><a href="/Home/OmOss">Om oss</a></li>
      <li><a href="/Home/Kontakt">Kontakt</a></li>
    </ul>
    <a href="/Home/Kontakt" class="nav-cta">Kontakt oss</a>
  </nav>

  @if (!string.IsNullOrWhiteSpace(ViewBag.VacationNotice as string))
  {
    <div class="vacation-bar"><span class="vacation-icon">✦</span><span>@ViewBag.VacationNotice</span></div>
  }

  <!-- HERO -->
  <section class="wh-hero">
    <div class="fade-up">
      <div class="wh-hero-tag">Webutvikling — Oslo sentrum</div>
      <h1 class="wh-hero-title">Vi bygger<br/>nettsider som<br/><em>faktisk selger</em></h1>
      <p class="wh-hero-sub">Skreddersydd design, mobilvenlig på alle enheter og et enkelt admin-panel så du kan oppdatere innholdet selv. Vi tar oss av alt fra idé til lansering.</p>
      <div class="wh-hero-actions">
        <a href="#kontakt" class="btn-gold">Få uforpliktende tilbud →</a>
        <a href="#prosess" class="btn-ghost" style="color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.3)">Se hvordan det fungerer</a>
      </div>
    </div>
    <div class="fade-up delay-2">
      <img src="/assets/images/webutvikling.svg" alt="Nettside illustrasjon" class="wh-hero-img" />
    </div>
  </section>

  <!-- HVA DU FÅR -->
  <section class="wh-section wh-features">
    <div class="wh-sec-tag fade-up">Hva er inkludert</div>
    <h2 class="wh-sec-title fade-up delay-1">Alt du trenger —<br/><em>ingenting du ikke trenger</em></h2>
    <div class="wh-grid">
      <div class="wh-feature fade-up"><div class="wh-feature-num">01</div><h3>Skreddersydd design</h3><p>Ingen maler. Din nettside får et unikt design tilpasset din bransje og merkevare.</p></div>
      <div class="wh-feature fade-up delay-1"><div class="wh-feature-num">02</div><h3>Mobilvenlig</h3><p>Ser bra ut og fungerer perfekt på mobil, nettbrett og desktop — alltid.</p></div>
      <div class="wh-feature fade-up delay-2"><div class="wh-feature-num">03</div><h3>Admin-panel</h3><p>Oppdater tekst, bilder og åpningstider selv — uten å kunne kode.</p></div>
      <div class="wh-feature fade-up"><div class="wh-feature-num">04</div><h3>Kontaktskjema</h3><p>Kunder sender meldinger direkte fra nettsiden. Du mottar dem på e-post.</p></div>
      <div class="wh-feature fade-up delay-1"><div class="wh-feature-num">05</div><h3>Domene & hosting</h3><p>Vi setter opp domenet og sørger for at nettsiden er live hele døgnet.</p></div>
      <div class="wh-feature fade-up delay-2"><div class="wh-feature-num">06</div><h3>Driftsavtale</h3><p>Månedlig vedlikehold og support etter lansering — vi passer på siden for deg.</p></div>
    </div>
  </section>

  <!-- PROSESS -->
  <section class="wh-section wh-process" id="prosess">
    <div class="wh-sec-tag fade-up">Slik jobber vi</div>
    <h2 class="wh-sec-title fade-up delay-1">Fra idé til<br/><em>ferdig nettside</em></h2>
    <div class="wh-steps">
      <div class="wh-step fade-up"><div class="wh-step-num">1</div><div><h3>Møte & planlegging</h3><p>Vi starter med en prat om hva du trenger og hvem kundene dine er. Ingen teknisk kunnskap kreves.</p></div></div>
      <div class="wh-step fade-up"><div class="wh-step-num">2</div><div><h3>Design & godkjenning</h3><p>Du ser designet før vi begynner å kode. Vi gjør justeringer til du er fornøyd.</p></div></div>
      <div class="wh-step fade-up"><div class="wh-step-num">3</div><div><h3>Utvikling & testing</h3><p>Vi bygger nettsiden og tester den grundig. Du får en forhåndsvisning før lansering.</p></div></div>
      <div class="wh-step fade-up"><div class="wh-step-num">4</div><div><h3>Lansering & opplæring</h3><p>Vi setter nettsiden live og lærer deg å bruke admin-panelet. Klar fra dag én.</p></div></div>
    </div>
  </section>

  <!-- REFERANSE -->
  <section class="wh-section wh-ref-section">
    <div class="wh-sec-tag fade-up">Referanse</div>
    <h2 class="wh-sec-title fade-up delay-1">Se et eksempel —<br/><em>denne nettsiden</em></h2>
    <div class="wh-ref">
      <div class="fade-up delay-1">
        <img src="/assets/images/webutvikling.svg" alt="sparekopi.no" class="wh-ref-img" />
      </div>
      <div class="fade-up delay-2">
        <div class="wh-ref-tag">sparekopi.no</div>
        <h3 class="wh-ref-title">Sparekopi — trykkeri & kopiering</h3>
        <p class="wh-ref-desc">Nettsiden du ser på nå er bygget av oss. Den har admin-panel, kontaktskjema, tjenesteoversikt, prisliste og ferievarsel — alt en lokal bedrift trenger.</p>
        <ul class="wh-ref-list">
          <li>Admin-panel for enkel oppdatering</li>
          <li>Mobilvenlig på alle enheter</li>
          <li>Kontaktskjema med e-postlevering</li>
          <li>Tjeneste- og prissider</li>
          <li>Ferievarsel og åpningstider</li>
        </ul>
        <a href="#kontakt" class="btn-gold">Vil du ha noe lignende? →</a>
      </div>
    </div>
  </section>

  <!-- UTVIKLER -->
  <section class="wh-section wh-dev-section">
    <div class="wh-sec-tag fade-up">Din utvikler</div>
    <h2 class="wh-sec-title fade-up delay-1">Hvem er det<br/><em>som bygger siden?</em></h2>
    <div class="wh-dev">
      <div class="fade-up delay-1">
        <div class="wh-dev-name">Joakim Pham</div>
        <div class="wh-dev-role">Data Science for Business · BI Norwegian Business School</div>
        <p class="wh-dev-text">Jeg er 22 år, fra Oslo, og studerer Data Science for Business på BI — nesten ferdig. Jeg har alltid vært interessert i teknologi og hva som skjer under panseret, og de siste årene har jeg brukt mye tid på å lære webutvikling fra bunnen av.</p>
        <p class="wh-dev-text">Jeg er vant til å jobbe effektivt og levere det jeg lover. Kombinasjonen av teknisk kompetanse og forretningsforståelse fra studiene gjør at jeg tenker på nettsiden din som et verktøy som skal gi deg kunder — ikke bare noe som ser fint ut.</p>
        <p class="wh-dev-text">Har du spørsmål eller vil bare ta en uforpliktende prat? Ring eller send en melding.</p>
        <a href="#kontakt" class="btn-gold" style="display:inline-block;margin-top:.5rem">Ta kontakt →</a>
      </div>
      <div class="fade-up delay-2">
        <div class="wh-dev-projects">
          <div class="wh-dev-project">
            <div class="wh-dev-project-tag">Prosjekt · 2025</div>
            <h4>sparekopi.no</h4>
            <p>Komplett nettside med admin-panel, tjenesteoversikt, prissider, kontaktskjema, ferievarsel og mobilvenlig design. Bygget med ASP.NET Core og hostet på Railway.</p>
          </div>
          <div class="wh-dev-project">
            <div class="wh-dev-project-tag">Prosjekt · 2024–2025</div>
            <h4>Kaceni</h4>
            <p>Eget webutviklingsprosjekt bygget fra bunnen av — et fullstack-prosjekt som viser bredden i det jeg kan levere, fra design til ferdig lansert løsning.</p>
          </div>
          <div class="wh-dev-project">
            <div class="wh-dev-project-tag">Utdanning · 2023 – nåværende</div>
            <h4>BI Norwegian Business School</h4>
            <p>Data Science for Business — kombinerer programmering, dataanalyse og forretningsforståelse. Nesten ferdig med graden.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TILBUD -->
  <section class="wh-section wh-offer-section">
    <div class="wh-sec-tag fade-up">Investering</div>
    <h2 class="wh-sec-title fade-up delay-1">Prisen settes etter<br/><em>ditt prosjekt</em></h2>
    <p class="wh-offer-lead fade-up delay-1">Ingen prisliste — fordi hvert prosjekt er ulikt. Etter en kort prat om hva du trenger, setter vi en fast pris. <em>Ingen timepris, ingen skjulte kostnader.</em> Du vet nøyaktig hva du betaler før vi starter.</p>
    <div class="wh-offer-factors">
      <div class="wh-offer-factor fade-up">
        <div class="wh-offer-factor-num">01</div>
        <h3>Omfang & innhold</h3>
        <p>Antall sider, mengde tekst og bilder, og om du allerede har innhold klart — alt dette påvirker tidsbruken.</p>
      </div>
      <div class="wh-offer-factor fade-up delay-1">
        <div class="wh-offer-factor-num">02</div>
        <h3>Funksjonalitet</h3>
        <p>Et enkelt kontaktskjema koster mindre enn et fullt admin-panel, booking-system eller nettbutikk. Vi bygger det du faktisk trenger.</p>
      </div>
      <div class="wh-offer-factor fade-up delay-2">
        <div class="wh-offer-factor-num">03</div>
        <h3>Driftsavtale</h3>
        <p>Du kan velge en engangsleveranse eller løpende support og vedlikehold etter lansering — det er opp til deg.</p>
      </div>
    </div>
    <a href="#kontakt" class="btn-gold fade-up">Ta kontakt for et tilbud →</a>
  </section>

  <!-- KONTAKT -->
  <section class="wh-section wh-contact-section" id="kontakt">
    <div class="wh-sec-tag fade-up">Kom i gang</div>
    <h2 class="wh-sec-title fade-up delay-1">La oss ta<br/><em>en prat</em></h2>
    <div class="wh-contact">
      <div class="fade-up delay-1">
        <p class="wh-contact-intro">Send oss en melding, ring eller kom innom butikken. Vi gir deg et uforpliktende tilbud — uten faglig sjargong og uten skjulte kostnader.</p>
        <div class="wh-contact-item"><div class="wh-contact-label">Telefon</div><div class="wh-contact-val"><a href="tel:+47@(ViewBag.Phone?.ToString().Replace(" ",""))">@ViewBag.Phone</a></div></div>
        <div class="wh-contact-item"><div class="wh-contact-label">E-post</div><div class="wh-contact-val"><a href="mailto:@ViewBag.Email">@ViewBag.Email</a></div></div>
        <div class="wh-contact-item"><div class="wh-contact-label">Besøk oss</div><div class="wh-contact-val">Torggata 17B, 2. etasje, Oslo</div></div>
      </div>
      <form class="fade-up delay-2" action="https://formspree.io/f/xeojpkqr" method="POST">
        <div class="form-group">
          <label class="form-label">Navn</label>
          <input type="text" name="navn" class="form-control" placeholder="Ditt navn" required />
        </div>
        <div class="form-group">
          <label class="form-label">E-post</label>
          <input type="email" name="epost" class="form-control" placeholder="din@epost.no" required />
        </div>
        <div class="form-group">
          <label class="form-label">Hva trenger du?</label>
          <textarea name="melding" class="form-control" rows="4" placeholder="Beskriv kort hva du ser etter." required></textarea>
        </div>
        <button type="submit" class="btn-gold" style="width:100%;text-align:center">Send forespørsel →</button>
      </form>
    </div>
  </section>

  <div class="map-strip">
