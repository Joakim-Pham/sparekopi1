@model Dictionary<string, string>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Forside-tekst";
    ViewData["PageTitle"] = "Rediger forside-tekst";
    string Get(string key) => Model != null && Model.TryGetValue(key, out var v) ? v : "";
}

<div style="max-width:620px;">
    <div class="content-card">
        <div class="content-card-title">Forsideinnhold</div>
        <p style="font-size:0.8125rem;color:#71717a;margin-bottom:24px;">
            Teksten som vises øverst på forsiden (hero-seksjonen) og i "Om Sparekopi"-blokken.
        </p>
        <form asp-action="Forside" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label" for="hero_subtitle">Hero-undertekst</label>
                <textarea name="hero_subtitle" id="hero_subtitle" class="form-control" rows="3">@Get("hero_subtitle")</textarea>
                <div class="form-text">Kortbeskrivelse under "Kvalitet som varer siden 1997".</div>
            </div>
            <div class="mb-4">
                <label class="form-label" for="about_index">Om Sparekopi-tekst (forsiden)</label>
                <textarea name="about_index" id="about_index" class="form-control" rows="5">@Get("about_index")</textarea>
                <div class="form-text">Teksten i "Om Sparekopi"-seksjonen på forsiden.</div>
            </div>
            <button type="submit" class="btn-save">Lagre forsideinnhold</button>
        </form>
    </div>
</div>
